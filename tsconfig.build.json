{
  // the ES module build, dist/esm, with its typings (npm run build:esm)
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist/esm",
    "declaration": true,
    "declarationMap": true,
    // (members marked @internal, such as ChantScore.getCustosPitch(), are left out of the typings)
    "stripInternal": true,
    "sourceMap": true,
    "inlineSources": true
  },
  "include": ["src"],
  // (tsconfig.nabc.json builds the NABC glyph data)
  "exclude": ["src/nabc"]
}
