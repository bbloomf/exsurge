{
  // type-checks the tests, including test/types.ts, which checks the types
  // that exsurge's source gives against how exsurge is used
  "extends": "../tsconfig.json",
  "compilerOptions": {
    // for the rollup config, which bundle.test.ts builds with
    "allowJs": true,
    "types": ["node", "opentype.js"],
    "paths": {
      "exsurge": ["../src/index.ts"]
    }
  },
  "include": ["**/*.ts"]
}
