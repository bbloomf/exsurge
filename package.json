{
  "name": "exsurge",
  "version": "1.30.1",
  "description": "A JavaScript library for rendering Gregorian Chant in square note notation",
  "main": "dist/exsurge.min.js",
  "types": "dist/esm/index.d.ts",
  "module": "dist/esm/index.js",
  "files": [
    "dist/exsurge.min.js",
    "dist/exsurge.min.js.map",
    "dist/esm",
    "src"
  ],
  "scripts": {
    "build": "npm run build:esm && npm run build:umd",
    "build:esm": "tsc -p tsconfig.build.json",
    "build:umd": "rollup -c",
    "dev": "rollup -c --watch",
    "lint": "eslint .",
    "test": "npm run lint && npm run test:types && vitest run",
    "test:types": "tsc -p . && tsc -p test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:reference": "vitest run test/reference",
    "bench": "npm run build:umd && node bench/layout.js",
    "preversion": "npm run build",
    "version": "npm run changelog && git add CHANGELOG.md dist/",
    "postversion": "git push && git push --tags",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^26.6.5",
    "@types/opentype.js": "^1.3.10",
    "@vitest/coverage-v8": "^5.0.5",
    "conventional-changelog-cli": "^5.0.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "rollup": "^4.64.12",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frmatthew/exsurge.git"
  },
  "author": "Fr. Matthew Spencer, O.S.J. <mspencer@osjusa.org> (http://marello.org)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/frmatthew/exsurge/issues"
  },
  "homepage": "https://github.com/frmatthew/exsurge#readme",
  "keywords": [
    "gregorian",
    "chant",
    "square",
    "note",
    "solesmes"
  ]
}
